msgstr "Impostazioni"

msgid "GitHub token deleted. You are now using unauthenticated API requests."
msgstr "Token GitHub eliminato. Le richieste API saranno ora non autenticate."

msgid "GitHub token saved successfully."
msgstr "Token GitHub salvato correttamente."

msgid "GitHub update checks run only on demand when you use \"Check updates now\" or start a bulk update."
msgstr "I controlli aggiornamenti GitHub vengono eseguiti solo su richiesta quando usi \"Controlla aggiornamenti ora\" o avvii un aggiornamento massivo."

msgid "Inactive"
msgstr "Inattivo"

msgid "Insert a public GitHub repository URL (owner/repo). The plugin downloads the latest Release package, or falls back to the latest Tag when no Release is available."
msgstr "Inserisci un URL pubblico di repository GitHub (owner/repo). Il plugin scarica il pacchetto dell'ultima Release, oppure usa l'ultimo Tag se non è disponibile alcuna Release."

msgid "Installed by default"
msgstr "Installato di default"

msgid "Latest package:"
msgstr "Pacchetto più recente:"

msgid "Default plugins do not require repository association."
msgstr "I plugin predefiniti non richiedono l'associazione di un repository."

msgid "Repository association not needed for default plugins."
msgstr "Associazione repository non necessaria per i plugin predefiniti."

msgid "Times shown in this page follow your YOURLS timezone configuration, or server time if that configuration is unavailable."
msgstr "Gli orari mostrati in questa pagina seguono la configurazione del fuso orario di YOURLS, oppure l'ora del server se tale configurazione non è disponibile."

msgid "Installed Plugins"
msgstr "Plugin installati"

msgid "Invalid GitHub URL."
msgstr "URL GitHub non valido."

