msgstr "Plugin eliminato con successo."

msgid "Plugin install"
msgstr "Installa plugin"

msgid "Notes"
msgstr "Note"

msgid "Plugin installed or updated successfully."
msgstr "Plugin installato o aggiornato correttamente."

