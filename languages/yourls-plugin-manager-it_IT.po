msgstr "Nessun plugin corrisponde al filtro selezionato."

msgid "No repository metadata"
msgstr "Nessun metadato repository"

msgid "No scopes are required – you can leave all permissions unchecked."
msgstr "Non sono necessari scope: puoi lasciare tutti i permessi deselezionati."

msgid "No updates available right now."
msgstr "Nessun aggiornamento disponibile al momento."

msgid "Not run yet"
msgstr "Non ancora eseguito"

