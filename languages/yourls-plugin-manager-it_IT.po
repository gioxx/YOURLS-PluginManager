msgstr "Nuova versione disponibile:"

msgid "Edit Token"
msgstr "Modifica Token"

msgid "Errors"
msgstr "Errori"

msgid "Extraction failed: unable to extract ZIP archive."
msgstr "Estrazione fallita: impossibile estrarre l'archivio ZIP."

msgid "Extraction failed: unable to open ZIP archive."
msgstr "Estrazione fallita: impossibile aprire l'archivio ZIP."

msgid "Failed to delete plugin."
msgstr "Impossibile eliminare il plugin."

msgid "Failed to move extracted plugin directory."
msgstr "Impossibile spostare la directory del plugin estratto."

msgid "Failed to replace existing plugin directory."
msgstr "Impossibile sostituire la directory del plugin esistente."

